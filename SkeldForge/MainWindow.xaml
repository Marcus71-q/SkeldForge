<Window x:Class="SkeldForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:SkeldForge.UI.Markup"
        xmlns:pages="clr-namespace:SkeldForge.ViewModels.Pages"
        xmlns:views="clr-namespace:SkeldForge.Views"
        Title="SkeldForge" Width="1280" Height="800" MinWidth="980" MinHeight="660"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="45" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type pages:HomeViewModel}"><views:HomeView/></DataTemplate>
        <DataTemplate DataType="{x:Type pages:ModpacksViewModel}"><views:ModpacksView/></DataTemplate>
        <DataTemplate DataType="{x:Type pages:ModpackDetailsViewModel}"><views:ModpackDetailsView/></DataTemplate>
        <DataTemplate DataType="{x:Type pages:ModLibraryViewModel}"><views:ModLibraryView/></DataTemplate>
        <DataTemplate DataType="{x:Type pages:VanillaCleanupViewModel}"><views:VanillaCleanupView/></DataTemplate>
        <DataTemplate DataType="{x:Type pages:BackupsViewModel}"><views:BackupsView/></DataTemplate>
        <DataTemplate DataType="{x:Type pages:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type pages:AboutViewModel}"><views:AboutView/></DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}" Width="236" HorizontalAlignment="Left" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"/>

        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/skeldforge-logo.png" Width="27" Height="27" Stretch="Uniform" Margin="0,0,8,0"/>
                <TextBlock Text="SKELDFORGE" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{loc:Loc App.Subtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="18,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource IconButton}" Width="46" Height="45" ToolTip="{loc:Loc Window.Minimize}" Click="Minimize_Click">
                    <TextBlock Text="―" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource IconButton}" Width="46" Height="45" ToolTip="{loc:Loc Window.Maximize}" Click="Maximize_Click">
                    <Grid Width="14" Height="14">
                        <TextBlock x:Name="MaximizeGlyph" Text="□" FontFamily="Segoe UI Symbol" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RestoreGlyph" Text="❐" Visibility="Collapsed" FontFamily="Segoe UI Symbol" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Width="48" Height="45" ToolTip="{loc:Loc Window.Close}" Click="Close_Click">
                    <Grid Width="14" Height="14">
                        <TextBlock Text="×" FontFamily="Segoe UI" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource DangerBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="12,18,12,14">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding SelectCommand}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Margin="0,0,0,5" Padding="12,10">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/><ColumnDefinition Width="3"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/><Border Grid.Column="2" Width="3" Height="18" CornerRadius="2" Background="{StaticResource AccentBrush}" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"/></Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Row="1" Margin="10,10,8,3">
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,13"/>
                    <TextBlock Text="{loc:Loc App.Version}" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                    <TextBlock Text="{loc:Loc App.Creator}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Background="{StaticResource WindowBrush}">
                <ContentControl Content="{Binding CurrentPage}"/>

                <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="24,14" Padding="14,10" CornerRadius="8" BorderThickness="1" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border"><Setter Property="Background" Value="{StaticResource SuccessDarkBrush}"/><Setter Property="BorderBrush" Value="#2C6657"/><Style.Triggers><DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Background" Value="{StaticResource DangerDarkBrush}"/><Setter Property="BorderBrush" Value="#6D3540"/></DataTrigger></Style.Triggers></Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="&#xE8BB;" Style="{StaticResource IconButton}" Command="{Binding DismissStatusCommand}" Margin="10,-7,-9,-7"/></StackPanel>
                </Border>

                <Border Background="#B20C0F16" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource RaisedCard}" Width="430" Padding="25" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel><TextBlock Text="{Binding ProgressText}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ProgressDetail}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,7,0,0" Visibility="{Binding ProgressDetail, Converter={StaticResource StringToVisibility}}"/><ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" Margin="0,18,0,0"/></StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.RowSpan="2" Background="{StaticResource WindowBrush}" Visibility="{Binding IsSetupRequired, Converter={StaticResource BoolToVisibility}}">
            <views:FirstRunView DataContext="{Binding FirstRun}"/>
        </Border>

        <Border Grid.RowSpan="2" Background="{StaticResource WindowBrush}" Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="SKELDFORGE" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/><ProgressBar IsIndeterminate="True" Width="220" Margin="0,22,0,0"/><TextBlock Text="{loc:Loc Common.Loading}" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel>
        </Border>
    </Grid>
</Window>
