<UserControl x:Class="SkeldForge.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SkeldForge.UI.Markup">
    <Grid Margin="38,32,38,36">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Loc Backups.Eyebrow}" Style="{StaticResource PageEyebrow}"/><TextBlock Text="{loc:Loc Backups.Title}" Style="{StaticResource PageTitle}"/><TextBlock Text="{loc:Loc Backups.Description}" Style="{StaticResource PageDescription}" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="1" Content="{loc:Loc Common.Refresh}" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom"/></Grid>
        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewer}" Margin="0,25,0,0">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Backups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,9" Padding="18">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="35" Height="35" CornerRadius="9" Background="{StaticResource InfoDarkBrush}" HorizontalAlignment="Left"><TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding KindText}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding DateText}"/><TextBlock Text="{Binding FileCountText}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="3" Orientation="Horizontal"><Button Content="{loc:Loc Backups.View}" Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0"/><Button Content="{loc:Loc Backups.Restore}" Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0"/><Button Content="&#xE74D;" Style="{StaticResource IconButton}" Foreground="{StaticResource DangerBrush}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{loc:Loc Common.Delete}"/></StackPanel></Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource Card}" Visibility="{Binding Backups.Count, Converter={StaticResource InverseCountToVisibility}}"><StackPanel HorizontalAlignment="Center" Margin="28"><TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource TextMutedBrush}" FontSize="27" HorizontalAlignment="Center"/><TextBlock Text="{loc:Loc Backups.Empty}" Foreground="{StaticResource TextMutedBrush}" Margin="0,11,0,0"/></StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
