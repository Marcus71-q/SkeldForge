<UserControl x:Class="SkeldForge.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SkeldForge.UI.Markup">
    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <Grid Margin="38,32,38,42">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,34,0">
                <TextBlock Text="{loc:Loc About.Eyebrow}" Style="{StaticResource PageEyebrow}"/>
                <Image Source="../Assets/skeldforge-logo.png" Width="72" Height="72" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,18,0,22"/>
                <TextBlock Text="{loc:Loc App.Name}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="40" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Loc App.Subtitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="17" Margin="0,5,0,0"/>
                <Border Style="{StaticResource Badge}" Margin="0,18,0,0"><TextBlock Text="{loc:Loc App.Version}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/></Border>
                <TextBlock Text="{loc:Loc About.Purpose}" Style="{StaticResource PageDescription}" Margin="0,24,0,0" FontSize="15" LineHeight="23"/>

                <Border Style="{StaticResource RaisedCard}" Margin="0,30,0,0" Padding="22">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc About.CreatedByLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="NyxShade" FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="{StaticResource AccentBrush}" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="{loc:Loc App.CreatorLong}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,50,0,0">
                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel><Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource SuccessDarkBrush}" HorizontalAlignment="Left"><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{loc:Loc About.SafetyTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0"/><TextBlock Text="{loc:Loc About.SafetyBody}" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20" Margin="0,8,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="22" Margin="0,12,0,0">
                    <StackPanel><Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource InfoDarkBrush}" HorizontalAlignment="Left"><TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource InfoBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{loc:Loc About.CommunityTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0"/><TextBlock Text="{loc:Loc App.IndependentDisclaimer}" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20" Margin="0,8,0,0"/><TextBlock Text="{loc:Loc About.License}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" LineHeight="17" Margin="0,12,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0"><TextBlock Text="{loc:Loc About.Runtime}" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" FontSize="11"/></Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
