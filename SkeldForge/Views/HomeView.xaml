<UserControl x:Class="SkeldForge.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SkeldForge.UI.Markup">
    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <StackPanel Margin="38,32,38,42">
            <TextBlock Text="{loc:Loc Home.Eyebrow}" Style="{StaticResource PageEyebrow}"/>
            <TextBlock Text="{loc:Loc Home.Welcome}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{loc:Loc Home.Description}" Style="{StaticResource PageDescription}" Margin="0,10,0,0"/>

            <Border Style="{StaticResource RaisedCard}" Margin="0,27,0,0" Padding="26">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource SuccessDarkBrush}" Margin="0,0,15,0"><TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel><TextBlock Text="{loc:Loc Home.GameStatus}" FontSize="17" FontWeight="SemiBold"/><Border Style="{StaticResource SuccessBadge}" Margin="0,6,0,0"><TextBlock Text="{loc:Loc Home.Detected}" Foreground="{StaticResource SuccessBrush}" FontSize="9" FontWeight="Bold"/></Border></StackPanel>
                        </StackPanel>
                        <TextBlock Text="{loc:Loc Home.SteamInstallation}" Style="{StaticResource LabelText}" Margin="0,20,0,5"/>
                        <TextBlock Text="{Binding GamePath}" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                        <Button Content="{loc:Loc Home.LaunchVanilla}" Command="{Binding LaunchVanillaCommand}" Margin="0,0,10,0"/>
                        <Button Content="{loc:Loc Home.CreateModpack}" Style="{StaticResource PrimaryButton}" Command="{Binding CreateModpackCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Columns="3" Margin="0,14,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="{loc:Loc Home.Modpacks}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding ModpackCount}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="7,0"><StackPanel><TextBlock Text="{loc:Loc Home.LibraryMods}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding LibraryCount}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel><TextBlock Text="{loc:Loc App.Version}" Style="{StaticResource LabelText}"/><TextBlock Text="1.0.2" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border>
            </UniformGrid>

            <Grid Margin="0,30,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Loc Home.Recent}" Style="{StaticResource SectionTitle}"/><TextBlock Grid.Column="1" Text="{loc:Loc Status.Ready}" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Visibility="{Binding Recent, Converter={StaticResource NullToVisibility}}"/></Grid>
            <Border Style="{StaticResource Card}" Visibility="{Binding Recent, Converter={StaticResource NullToVisibility}}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Recent.Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Recent.LastUsedText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{loc:Loc Common.Open}" Command="{Binding OpenModpackCommand}" CommandParameter="{Binding Recent}" Margin="0,0,9,0"/><Button Content="{loc:Loc Modpack.Play}" Style="{StaticResource PrimaryButton}" Command="{Binding PlayModpackCommand}" CommandParameter="{Binding Recent}"/></StackPanel></Grid>
            </Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding Recent, Converter={StaticResource InverseNullToVisibility}}"><TextBlock Text="{loc:Loc Home.NoRecent}" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="15"/></Border>

            <TextBlock Text="{loc:Loc Home.YourModpacks}" Style="{StaticResource SectionTitle}" Margin="0,30,0,12"/>
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="280" MinHeight="148" Margin="0,0,12,12">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><Border Style="{StaticResource Badge}"><TextBlock Text="{loc:Loc Status.Modded}" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold"/></Border><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Margin="0,13,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ModCountText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel><Button Grid.Row="1" Content="{loc:Loc Common.Open}" Command="{Binding DataContext.OpenModpackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,15,0,0"/></Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{loc:Loc Home.NoModpacks}" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" Visibility="{Binding Cards.Count, Converter={StaticResource InverseCountToVisibility}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
