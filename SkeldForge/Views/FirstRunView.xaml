<UserControl x:Class="SkeldForge.Views.FirstRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SkeldForge.UI.Markup">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="58,58,48,46">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="../Assets/skeldforge-logo.png" Width="34" Height="34" Stretch="Uniform" Margin="0,0,12,0"/>
                        <TextBlock Text="SKELDFORGE" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc App.Subtitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="47,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Setup.Eyebrow}" Style="{StaticResource PageEyebrow}"/>
                    <TextBlock Text="{loc:Loc Setup.Title}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="38" FontWeight="SemiBold" LineHeight="46"/>
                    <TextBlock Text="{loc:Loc Setup.Description}" Style="{StaticResource PageDescription}" Margin="0,18,0,0" LineHeight="22"/>
                    <Border Style="{StaticResource Card}" Background="{StaticResource SuccessDarkBrush}" Margin="0,30,0,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" FontSize="18" Margin="0,1,13,0"/><StackPanel><TextBlock Text="{loc:Loc Status.Vanilla}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{loc:Loc Cleanup.UnknownSafety}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel></StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="{loc:Loc App.CreatorLong}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="72,52">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{loc:Loc Setup.Language}" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedLanguage}" MinWidth="140"/>
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="590">
                <TextBlock Text="{loc:Loc Setup.PathLabel}" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource RaisedCard}" Padding="22">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="31" Height="31" CornerRadius="16" Background="{StaticResource AccentDarkBrush}" HorizontalAlignment="Left"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{Binding SelectedPath}" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" Visibility="{Binding SelectedPath, Converter={StaticResource StringToVisibility}}"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar IsIndeterminate="True" Margin="0,20,0,0" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}"/>
                        <Border Style="{StaticResource Divider}" Margin="0,20,0,17"/>
                        <TextBlock Text="{loc:Loc Setup.ValidationHint}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" LineHeight="17"/>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="{loc:Loc Setup.SelectFolder}" Command="{Binding SelectFolderCommand}" Margin="0,0,10,0"/>
                            <Button Content="{loc:Loc Common.Refresh}" Command="{Binding RetryDetectionCommand}" Style="{StaticResource QuietButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Button Content="{loc:Loc Setup.Continue}" Style="{StaticResource PrimaryButton}" Command="{Binding ContinueCommand}" HorizontalAlignment="Stretch" Margin="0,18,0,0" MinHeight="46"/>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="{loc:Loc App.IndependentDisclaimer}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="520"/>
        </Grid>
    </Grid>
</UserControl>
