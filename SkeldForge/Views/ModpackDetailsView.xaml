<UserControl x:Class="SkeldForge.Views.ModpackDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SkeldForge.UI.Markup"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <StackPanel Margin="38,28,38,42">
            <Button Style="{StaticResource QuietButton}" Command="{Binding BackCommand}" HorizontalAlignment="Left" Margin="-10,0,0,12">
                <StackPanel Orientation="Horizontal"><TextBlock Text="←" Margin="0,0,8,0"/><TextBlock Text="{loc:Loc Common.Back}"/></StackPanel>
            </Button>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding Model.Name}" Style="{StaticResource PageTitle}"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Border Style="{StaticResource Badge}" Margin="0,0,9,0"><TextBlock Text="{loc:Loc Status.Modded}" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold"/></Border><TextBlock Text="{Binding Model.Mods.Count}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{loc:Loc Modpack.Mods}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/></StackPanel></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{loc:Loc Modpack.Export}" Command="{Binding ExportCommand}" Margin="0,0,9,0"/><Button Content="{loc:Loc Modpack.AddMod}" Command="{Binding AddModCommand}" Margin="0,0,9,0"/><Button Content="{loc:Loc Modpack.Play}" Style="{StaticResource PrimaryButton}" Command="{Binding PlayCommand}"/></StackPanel>
            </Grid>

            <UniformGrid Columns="3" Margin="0,25,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="{loc:Loc Modpack.ModpackVersion}" Style="{StaticResource LabelText}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Model.Version}" FontSize="19" FontWeight="SemiBold"/><Button Grid.Column="1" Content="&#xE70F;" Style="{StaticResource IconButton}" Command="{Binding EditVersionCommand}" ToolTip="{loc:Loc Modpack.ChangeVersion}"/></Grid></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="7,0"><StackPanel><TextBlock Text="{loc:Loc Modpack.SourceVersion}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding SourceGameVersionText}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel><TextBlock Text="{loc:Loc Modpack.Instance}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding Model.GameDirectory}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/><Button Content="{loc:Loc Modpack.OpenFolder}" Command="{Binding OpenFolderCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,5" Margin="0,5,0,0"/></StackPanel></Border>
            </UniformGrid>

            <Border Style="{StaticResource RaisedCard}" Margin="0,15,0,0" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource InfoDarkBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource InfoBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Modpack.GameBase}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding GameUpdateStatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{loc:Loc Modpack.BackupInstance}" Command="{Binding BackupInstanceCommand}" Margin="0,0,8,0"/>
                        <Button Content="{loc:Loc Modpack.CheckGameUpdate}" Command="{Binding CheckGameUpdateCommand}" Margin="0,0,8,0"/>
                        <Button Content="{loc:Loc Modpack.UpdateGame}" Style="{StaticResource DangerButton}" Command="{Binding UpdateGameCommand}" Visibility="{Binding HasGameUpdate, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource RaisedCard}" BorderBrush="{StaticResource AccentDarkBrush}" BorderThickness="1" Margin="0,15,0,0" Padding="25">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource AccentDarkBrush}" HorizontalAlignment="Left"><TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource AccentBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{loc:Loc Modpack.DropTitle}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc Modpack.DropDescription}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="2" Content="{loc:Loc Modpack.SelectZip}" Command="{Binding AddModCommand}" VerticalAlignment="Center"/></Grid>
            </Border>

            <Grid Margin="0,28,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Loc Modpack.Mods}" Style="{StaticResource SectionTitle}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{loc:Loc Common.Rename}" Command="{Binding RenameCommand}" Style="{StaticResource QuietButton}" Margin="0,0,2,0"/><Button Content="{loc:Loc Modpack.Duplicate}" Command="{Binding DuplicateCommand}" Style="{StaticResource QuietButton}" Margin="0,0,2,0"/><Button Content="{loc:Loc Common.Delete}" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/></StackPanel></Grid>
            <ItemsControl ItemsSource="{Binding Mods}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="17" Margin="0,0,0,9">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource AccentDarkBrush}" HorizontalAlignment="Left"><TextBlock Text="&#xE943;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Version}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{loc:Loc Mod.Status}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="3" Orientation="Horizontal"><ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{loc:Loc Mod.Enable}" Margin="0,7,10,0" VerticalAlignment="Top"/><Button Content="{loc:Loc Common.Details}" Command="{Binding DataContext.ModDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0"/><Button Content="&#xE74D;" Style="{StaticResource IconButton}" Foreground="{StaticResource DangerBrush}" Command="{Binding DataContext.RemoveModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{loc:Loc Common.Remove}"/></StackPanel></Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource Card}" Visibility="{Binding Mods.Count, Converter={StaticResource InverseCountToVisibility}}"><StackPanel HorizontalAlignment="Center" Margin="20"><TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource TextMutedBrush}" FontSize="25" HorizontalAlignment="Center"/><TextBlock Text="{loc:Loc Modpack.NoMods}" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"/></StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
