<UserControl x:Class="SkeldForge.Views.ModpacksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SkeldForge.UI.Markup">
    <Grid Margin="38,32,38,36">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Loc Modpacks.Eyebrow}" Style="{StaticResource PageEyebrow}"/><TextBlock Text="{loc:Loc Modpacks.Title}" Style="{StaticResource PageTitle}"/><TextBlock Text="{loc:Loc Modpacks.Description}" Style="{StaticResource PageDescription}" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="{loc:Loc Modpacks.Import}" Command="{Binding ImportCommand}" Margin="0,0,10,0"/><Button Content="{loc:Loc Modpacks.Create}" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}"/></StackPanel></Grid>
        <Grid Grid.Row="1" Margin="0,25,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><Grid Margin="0,0,12,0"><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc Modpacks.Search}"/><TextBlock Text="{loc:Loc Modpacks.Search}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="13,0" IsHitTestVisible="False" Visibility="{Binding SearchText, Converter={StaticResource InverseStringToVisibility}}"/></Grid><ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSort}"/></Grid>
        <ScrollViewer Grid.Row="2" Style="{StaticResource PageScrollViewer}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding CardsView}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="300" Height="192" Margin="0,0,13,13">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource Badge}"><TextBlock Text="{loc:Loc Status.Ready}" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold"/></Border><TextBlock Grid.Column="1" Text="{Binding Version}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/></Grid><StackPanel Grid.Row="1" Margin="0,14,0,0"><TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ModCountText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0"/><TextBlock Text="{Binding CreatedText}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel><Button Grid.Row="2" Content="{loc:Loc Modpacks.Open}" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Stretch"/></Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource Card}" Visibility="{Binding CardsView.IsEmpty, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{loc:Loc Modpacks.Empty}" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="20"/></Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
