<UserControl x:Class="SkeldForge.Views.VanillaCleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SkeldForge.UI.Markup">
    <ScrollViewer Style="{StaticResource PageScrollViewer}">
        <StackPanel Margin="38,32,38,42">
            <TextBlock Text="{loc:Loc Cleanup.Eyebrow}" Style="{StaticResource PageEyebrow}"/>
            <TextBlock Text="{loc:Loc Cleanup.Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{loc:Loc Cleanup.Intro}" Style="{StaticResource PageDescription}" Margin="0,9,0,0"/>

            <StackPanel Visibility="{Binding IsIntro, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource RaisedCard}" Margin="0,25,0,0" Padding="26">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Cleanup.HowTitle}" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl>
                            <ItemsControl.Items>
                                <TextBlock Text="{loc:Loc Cleanup.Step1}"/>
                                <TextBlock Text="{loc:Loc Cleanup.Step2}"/>
                                <TextBlock Text="{loc:Loc Cleanup.Step3}"/>
                                <TextBlock Text="{loc:Loc Cleanup.Step4}"/>
                                <TextBlock Text="{loc:Loc Cleanup.Step5}"/>
                                <TextBlock Text="{loc:Loc Cleanup.Step6}"/>
                            </ItemsControl.Items>
                            <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentDarkBrush}" HorizontalAlignment="Left"><TextBlock Text="•" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter Grid.Column="1" Content="{Binding}"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource WarningBadge}" Margin="0,20,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource WarningBrush}" Margin="0,1,10,0"/><TextBlock Text="{loc:Loc Cleanup.UnknownSafety}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/></StackPanel></Border>
                        <TextBlock Text="{loc:Loc Cleanup.PermissionHint}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
                <Button Content="{loc:Loc Cleanup.StartScan}" Style="{StaticResource PrimaryButton}" Command="{Binding StartScanCommand}" HorizontalAlignment="Left" Margin="0,18,0,0" MinWidth="180"/>
            </StackPanel>

            <StackPanel Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="0,25,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Loc Cleanup.ScanComplete}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Scan.GamePath}" Foreground="{StaticResource TextMutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="10"/></StackPanel><Button Grid.Column="1" Content="{loc:Loc Common.Refresh}" Command="{Binding ScanAgainCommand}"/></Grid>
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="{loc:Loc Cleanup.Known}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding KnownFindings.Count}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="7,0"><StackPanel><TextBlock Text="{loc:Loc Cleanup.Protected}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding ProtectedFindings.Count}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel><TextBlock Text="{loc:Loc Cleanup.Unknown}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding UnknownFindings.Count}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/></StackPanel></Border>
                </UniformGrid>
                <TextBlock Text="{loc:Loc Cleanup.Known}" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
                <ItemsControl ItemsSource="{Binding KnownFindings}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="13" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource DangerBrush}"/><TextBlock Grid.Column="1" Text="{Binding RelativePath}" FontFamily="Cascadia Mono, Consolas" FontSize="11"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Expander Margin="0,16,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                    <Expander.Header><TextBlock Text="{loc:Loc Cleanup.Protected}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/></Expander.Header>
                    <ItemsControl ItemsSource="{Binding ProtectedFindings}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding RelativePath}" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource SuccessBrush}" FontSize="11" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </Expander>
                <Expander Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                    <Expander.Header><TextBlock Text="{loc:Loc Cleanup.Unknown}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/></Expander.Header>
                    <ItemsControl ItemsSource="{Binding UnknownFindings}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding RelativePath}" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </Expander>
                <Border Style="{StaticResource WarningBadge}" Margin="0,16,0,0"><TextBlock Text="{loc:Loc Cleanup.UnknownRemain}" Foreground="{StaticResource WarningBrush}"/></Border>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="{loc:Loc Common.Cancel}" Command="{Binding CancelPreviewCommand}" Margin="0,0,10,0"/><Button Content="{loc:Loc Cleanup.Clean}" Style="{StaticResource DangerButton}" Command="{Binding CleanCommand}"/></StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource RaisedCard}" Background="{StaticResource SuccessDarkBrush}" Margin="0,25,0,0" Padding="28">
                    <StackPanel><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" FontSize="30"/><TextBlock Text="{loc:Loc Cleanup.Complete}" FontSize="24" FontWeight="SemiBold" Margin="0,13,0,0"/><TextBlock Text="{loc:Loc Cleanup.BackupCreated}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,15,0,0"/><TextBlock Text="{loc:Loc Cleanup.Removed}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/><TextBlock Text="{loc:Loc Cleanup.Verified}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="{loc:Loc Cleanup.ViewChanges}" Command="{Binding ViewChangesCommand}" Margin="0,0,9,0"/><Button Content="{loc:Loc Cleanup.RestoreBackup}" Command="{Binding RestoreBackupCommand}" Margin="0,0,9,0"/><Button Content="{loc:Loc Cleanup.LaunchVanilla}" Style="{StaticResource PrimaryButton}" Command="{Binding LaunchVanillaCommand}"/></StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
