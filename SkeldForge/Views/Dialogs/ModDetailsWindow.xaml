<Window x:Class="SkeldForge.Views.Dialogs.ModDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SkeldForge.UI.Markup"
        Title="{loc:Loc Mod.DetailsTitle}" Width="650" Height="670"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="24,20,18,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding Mod.Name}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc Mod.DetailsTitle}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
                <Button Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource IconButton}" IsCancel="True"/>
            </Grid>
            <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewer}">
                <StackPanel Margin="24,0,24,22">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{loc:Loc Common.Version}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding VersionText}" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="{loc:Loc Mod.Status}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{loc:Loc Mod.Compatibility}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding CompatibilityText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/></StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{loc:Loc Mod.PackageHash}" Style="{StaticResource LabelText}" Margin="0,20,0,6"/>
                    <TextBlock Text="{Binding Mod.PackageHash}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Loc Mod.Dependencies}" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
                    <ItemsControl ItemsSource="{Binding Dependencies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="13" Margin="0,0,0,7">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/></Border></Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Loc Mod.NoDependencies}" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding Dependencies.Count, Converter={StaticResource InverseCountToVisibility}}"/>
                    <TextBlock Text="{loc:Loc Mod.InstalledFiles}" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
                    <ItemsControl ItemsSource="{Binding Mod.InstalledFiles}">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding RelativePath}" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Loc Mod.NoTrackedFiles}" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding Mod.InstalledFiles.Count, Converter={StaticResource InverseCountToVisibility}}"/>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16"><Button Content="{loc:Loc Common.Close}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" IsCancel="True"/></Border>
        </Grid>
    </Border>
</Window>
