<Window x:Class="SkeldForge.Views.Dialogs.PackageAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SkeldForge.UI.Markup"
        Title="{loc:Loc Package.Title}" Width="720" Height="700" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="24,20,18,14" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Package.Title}" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Analysis.ArchiveName}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource IconButton}" IsCancel="True"/>
            </Grid>
            <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewer}">
                <StackPanel Margin="24,4,24,20">
                    <Border Style="{StaticResource Card}" Background="{Binding SafetyBackground}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SafetyIcon}" FontFamily="Segoe Fluent Icons" Foreground="{Binding SafetyForeground}" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:Loc Package.Safety}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SafetyText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding SafetyDetail}" Foreground="{StaticResource DangerBrush}" Margin="0,5,0,0" Visibility="{Binding SafetyDetail, Converter={StaticResource StringToVisibility}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{loc:Loc Package.Detected}" Style="{StaticResource SectionTitle}" Margin="0,22,0,12"/>
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource Card}" Margin="0,0,6,8" Padding="14" Opacity="{Binding Analysis.HasBepInExStructure, Converter={StaticResource BoolToOpacity}}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" Margin="0,0,9,0"/><TextBlock Text="{loc:Loc Package.BepInEx}"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0,0,8" Padding="14" Opacity="{Binding Analysis.HasPluginDlls, Converter={StaticResource BoolToOpacity}}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" Margin="0,0,9,0"/><TextBlock Text="{loc:Loc Package.Plugins}"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="14" Opacity="{Binding Analysis.HasConfigurationFiles, Converter={StaticResource BoolToOpacity}}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" Margin="0,0,9,0"/><TextBlock Text="{loc:Loc Package.Config}"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="14" Opacity="{Binding Analysis.HasLoaderComponents, Converter={StaticResource BoolToOpacity}}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" Margin="0,0,9,0"/><TextBlock Text="{loc:Loc Package.Loader}"/></StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource WarningBadge}" Margin="0,16,0,0" Visibility="{Binding IsUnknownStructure, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:Loc Package.UnknownStructure}" Foreground="{StaticResource WarningBrush}" LineHeight="19"/>
                    </Border>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="{loc:Loc Common.Name}" Style="{StaticResource LabelText}"/><TextBox Text="{Binding Analysis.DetectedName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="{loc:Loc Common.Version}" Style="{StaticResource LabelText}"/><TextBox Text="{Binding Analysis.DetectedVersion, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="{loc:Loc Package.Files}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding Analysis.FileCount}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel>
                    </Grid>

                    <TextBlock Text="{loc:Loc Package.Hash}" Style="{StaticResource LabelText}" Margin="0,22,0,6"/>
                    <TextBlock Text="{Binding Analysis.Sha256}" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>

                    <TextBlock Text="{loc:Loc Package.PluginList}" Style="{StaticResource LabelText}" Margin="0,20,0,6" Visibility="{Binding Analysis.PluginFiles.Count, Converter={StaticResource CountToVisibility}}"/>
                    <ItemsControl ItemsSource="{Binding Analysis.PluginFiles}" Visibility="{Binding Analysis.PluginFiles.Count, Converter={StaticResource CountToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Expander Margin="0,18,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                        <Expander.Header><TextBlock Text="{loc:Loc Common.Details}" Foreground="{StaticResource TextSecondaryBrush}"/></Expander.Header>
                        <ListBox ItemsSource="{Binding Analysis.Entries}" MaxHeight="220" Margin="0,8,0,0">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding RelativePath}" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="4,2"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Common.Cancel}" IsCancel="True" Margin="0,0,10,0"/>
                    <Button Content="{loc:Loc Common.Install}" Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="{Binding Analysis.IsSafe}" Click="Install_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
