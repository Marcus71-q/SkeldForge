<Window x:Class="SkeldForge.Views.Dialogs.BackupManifestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SkeldForge.UI.Markup"
        Title="{loc:Loc Backups.ManifestTitle}" Width="720" Height="650"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="24,20,18,16" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Loc Backups.ManifestTitle}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource IconButton}" IsCancel="True"/></Grid>
            <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewer}">
                <StackPanel Margin="24,0,24,22">
                    <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Loc Common.Name}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{loc:Loc Backups.FileCount}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding Files.Count}" FontWeight="SemiBold"/></StackPanel></Grid></Border>
                    <TextBlock Text="{Binding SourceRoot}" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,14,0,0"/>
                    <TextBlock Text="{loc:Loc Common.Details}" Style="{StaticResource SectionTitle}" Margin="0,22,0,10"/>
                    <ItemsControl ItemsSource="{Binding Files}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><Border Style="{StaticResource Card}" Padding="13" Margin="0,0,0,7"><StackPanel><TextBlock Text="{Binding RelativePath}" FontFamily="Cascadia Mono, Consolas" FontSize="11"/><TextBlock Text="{Binding Sha256}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16"><Button Content="{loc:Loc Common.Close}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" IsCancel="True"/></Border>
        </Grid>
    </Border>
</Window>
