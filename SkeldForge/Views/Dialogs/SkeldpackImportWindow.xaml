<Window x:Class="SkeldForge.Views.Dialogs.SkeldpackImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SkeldForge.UI.Markup"
        Title="{loc:Loc Modpack.ImportTitle}" Width="600" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="24,20,18,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Modpack.ImportTitle}" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Preview.Manifest.Name}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource IconButton}" IsCancel="True"/>
            </Grid>
            <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewer}">
                <StackPanel Margin="24,0,24,20">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{loc:Loc Common.Name}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding Preview.Manifest.Name}" FontWeight="SemiBold" FontSize="16"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="{loc:Loc Common.Version}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding Preview.Manifest.Version}" FontWeight="SemiBold" FontSize="16"/></StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{loc:Loc Modpack.ImportFound}" Style="{StaticResource SectionTitle}" Margin="0,22,0,10"/>
                    <ItemsControl ItemsSource="{Binding Preview.FoundMods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="13" Margin="0,0,0,7">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Version}" Foreground="{StaticResource TextSecondaryBrush}"/></Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Loc Common.None}" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding Preview.FoundMods.Count, Converter={StaticResource InverseCountToVisibility}}"/>
                    <TextBlock Text="{loc:Loc Modpack.ImportMissing}" Style="{StaticResource SectionTitle}" Margin="0,22,0,10"/>
                    <ItemsControl ItemsSource="{Binding Preview.MissingMods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Background="{StaticResource WarningDarkBrush}" Padding="13" Margin="0,0,0,7">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource WarningBrush}"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Version}" Foreground="{StaticResource WarningBrush}"/></Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Loc Common.None}" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding Preview.MissingMods.Count, Converter={StaticResource InverseCountToVisibility}}"/>
                    <Border Style="{StaticResource WarningBadge}" Margin="0,20,0,0"><TextBlock Text="{loc:Loc Modpack.ImportSafety}" Foreground="{StaticResource WarningBrush}" LineHeight="19"/></Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{loc:Loc Common.Cancel}" IsCancel="True" Margin="0,0,10,0"/><Button Content="{loc:Loc Common.Import}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Import_Click"/></StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
