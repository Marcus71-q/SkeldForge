<Window x:Class="SkeldForge.Views.Dialogs.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SkeldForge.UI.Markup"
        Title="{Binding Title}"
        Width="470" SizeToContent="Height" MaxHeight="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="16" Background="{Binding IconBackground}" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" Foreground="{Binding IconForeground}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" LineHeight="21" Margin="42,16,0,0"/>
            <Expander Grid.Row="2" Margin="42,14,0,0" Visibility="{Binding Details, Converter={StaticResource StringToVisibility}}" Foreground="{StaticResource TextSecondaryBrush}">
                <Expander.Header>
                    <TextBlock Text="{loc:Loc Common.Details}" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Expander.Header>
                <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0" MaxHeight="180">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding Details}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Expander>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="{loc:Loc Common.Cancel}" IsCancel="True" Margin="0,0,10,0" Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="{Binding AcceptText}" IsDefault="True" Click="Accept_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
