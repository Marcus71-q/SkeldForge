<Window x:Class="SkeldForge.Views.Dialogs.RestoreReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SkeldForge.UI.Markup"
        Title="{loc:Loc Backups.Restore}" Width="680" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="24,20,18,16" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Loc Backups.Restore}" FontSize="22" FontWeight="SemiBold"/><Button Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource IconButton}" IsCancel="True"/></Grid>
            <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewer}"><StackPanel Margin="24,0,24,22"><UniformGrid Columns="3" Margin="0,0,0,18"><Border Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><TextBlock Text="{loc:Loc Restore.Restored}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding RestoredCount}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="3,0"><StackPanel><TextBlock Text="{loc:Loc Restore.Conflict}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding ConflictCount}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="6,0,0,0"><StackPanel><TextBlock Text="{loc:Loc Restore.Error}" Style="{StaticResource LabelText}"/><TextBlock Text="{Binding ErrorCount}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/></StackPanel></Border></UniformGrid><ItemsControl ItemsSource="{Binding Entries}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="13" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding RelativePath}" FontFamily="Cascadia Mono, Consolas" FontSize="11"/><TextBlock Text="{Binding Message}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" Visibility="{Binding Message, Converter={StaticResource StringToVisibility}}"/></StackPanel><Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" FontSize="10"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16"><Button Content="{loc:Loc Common.Close}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" IsCancel="True"/></Border>
        </Grid>
    </Border>
</Window>
