<Window x:Class="SkeldForge.Views.Dialogs.PromptDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SkeldForge.UI.Markup"
        Title="{Binding Title}" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Label}" Style="{StaticResource LabelText}" Margin="0,20,0,6"/>
            <TextBox x:Name="ValueBox" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
            <TextBlock x:Name="ValidationText" Text="{loc:Loc Dialog.PromptRequired}" Foreground="{StaticResource DangerBrush}" Margin="0,7,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="{loc:Loc Common.Cancel}" IsCancel="True" Margin="0,0,10,0"/>
                <Button Content="{loc:Loc Common.Confirm}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Accept_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
